# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---- App ----
APP_NAME=Blood Donor-Recipient Connection Platform API
ENVIRONMENT=development
DEBUG=true

# ---- Security / JWT ----
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- MongoDB Atlas ----
# Get this connection string from Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=blood_donor_platform

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- OTP / Email verification ----
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# ---- SMTP (leave blank to log OTPs to the console in development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/jpg

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_OTP=5/minute

# ---- Community outreach (OSM harvest + contact scrape) ----
# Set to false to disable the OSM/outreach hand-off entirely (a blood request
# still gets created normally either way -- this is a secondary feature).
OUTREACH_ENABLED=true
OUTREACH_RADIUS_METRES=5000
OUTREACH_CATEGORIES=college,university,restaurant,pub
# Must match the --db path (or default ./osmharvest.db) that the osmharvest
# worker process is using, so both sides agree on where jobs live.
OSM_DB_PATH=../../OsmProject/osmharvest.db
