# Copy to .env and fill in before sending for real. Not needed for --dry-run.
#
# Gmail specifically: SMTP_PASSWORD must be a 16-character App Password, not
# your normal account password -- Gmail has required this for SMTP since
# 2022. Generate one at: Google Account > Security > 2-Step Verification
# (must be turned on first) > App passwords.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=lifeline09990@gmail.com
SMTP_PASSWORD=qbzfoejryixahfaw
SMTP_FROM_EMAIL=lifeline09990@gmail.com
SMTP_USE_TLS=true