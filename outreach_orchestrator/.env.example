# Copy to .env (same folder as orchestrator.py) so MONGO_URI survives across
# terminal restarts -- no more `set "MONGO_URI=..."` every session.
# CLI flags (--mongo-uri etc.) still override this if you pass them.

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=blood_donor_platform
OSM_DB=../OsmProject/osmharvest.db
OSM_EXPORT_DIR=../OsmProject/exports
CONTACTS_DIR=./contacts
MAX_PLACES=40
POLL_SECONDS=30
